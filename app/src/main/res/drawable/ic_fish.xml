        android:pathData="M10,17.1a1.9,1.9 0 1,0 0,3.8a1.9,1.9 0 1,0 0,-3.8z"
        android:fillColor="#FFFFFF" android:fillAlpha="0.55" />
    <path
        android:pathData="M5.5,12.2a1.3,1.3 0 1,0 0,2.6a1.3,1.3 0 1,0 0,-2.6z"
        android:fillColor="#FFFFFF" android:fillAlpha="0.4" />
