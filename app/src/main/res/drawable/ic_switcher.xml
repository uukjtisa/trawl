<?xml version="1.0" encoding="utf-8"?>
<!--
    The window-switcher glyph. NEW FILE (Trawl project, 2026-08-25).

    Transcribed from the mockup's #i-switch sprite. Two offset cards: the front one solid, the
    one behind it at half opacity.

    NOT a hamburger, on purpose (D-10). The drawer does not slide a menu over the page, it pushes
    the current screen back and lets you pick another — so the control has to promise a switch
    between windows rather than a list of links. Three stacked lines promise the wrong thing.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="?attr/colorControlNormal">
    <!-- the card behind -->
    <path
        android:pathData="M7.6,3.4h9.8a3,3 0 0 1 3,3v9.4"
        android:strokeColor="#FFFFFF" android:strokeWidth="1.9" android:strokeAlpha="0.5"
        android:strokeLineJoin="round" />
    <!-- the front card -->
    <path
        android:pathData="M5.8,6.4h9.2a2.6,2.6 0 0 1 2.6,2.6v8.2a2.6,2.6 0 0 1 -2.6,2.6h-9.2a2.6,2.6 0 0 1 -2.6,-2.6v-8.2a2.6,2.6 0 0 1 2.6,-2.6z"
        android:strokeColor="#FFFFFF" android:strokeWidth="1.9"
        android:strokeLineJoin="round" />
</vector>
